# ─────────────────────────────────────────────────────────────────────
# Modèle de configuration : `cp .env.example .env` puis remplis les valeurs.
# Le .env réel n'est JAMAIS commité (il contient les vraies credentials).
#
# Les noms ci-dessous doivent correspondre exactement à ceux lus par le code
# (api/core/settings.py, frontend/) : une variable mal nommée est ignorée
# en silence, ou fait crasher le backend au démarrage.
#
# Redis et Celery ne lisent rien ici : broker et scheduler sont en dur
# dans api/core/settings.py.
# ─────────────────────────────────────────────────────────────────────

# ── Django ───────────────────────────────────────────────────────────
# Générer une clé : python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Quotes simples obligatoires : la clé contient souvent des $, que docker
# compose interpolerait sinon (valeur tronquée ou vide, sans erreur).
DJANGO_SECRET_KEY='remplace-moi'

# Seule bascule dev/prod. True en local ; retirer ou False en prod.
# Pilote DEBUG, ALLOWED_HOSTS et les origines CORS/CSRF (cf. settings.py).
# Absente = False → seuls les domaines kop.life sont acceptés.
DJANGO_DEBUG=True

# ── PostgreSQL ───────────────────────────────────────────────────────
# Lues à la fois par l'image postgres (création de la base) et par Django.
POSTGRES_DB=transcendence
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=transcendence
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Google OAuth ─────────────────────────────────────────────────────
# console.cloud.google.com → API et services → Identifiants → ID client OAuth.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID = même valeur que GOOGLE_CLIENT_ID : le front
# en a besoin côté navigateur (inlinée au build du conteneur frontend).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Brevo (emails transactionnels : 2FA, vérification) ───────────────
BREVO_API_KEY=

# ── URLs de l'API ────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL : appelée depuis le navigateur (et dérive l'URL WebSocket).
#                       En dev tout passe par nginx en HTTPS : https://localhost:8443.
# API_URL             : appelée depuis les routes serveur Next, de conteneur
#                       à conteneur — d'où le nom de service, pas localhost.
NEXT_PUBLIC_API_URL=https://localhost:8443
API_URL=http://backend:8000

# ── Prod uniquement ──────────────────────────────────────────────────
# Ignorées en dev (`docker compose up`) ; nginx est sous le profil "prod".
# NEXT_PUBLIC_API_URL_PROD : URL publique inlinée au build du frontend
#                            (défaut https://kop.life si non défini).
# CERTBOT_EMAIL            : email d'enregistrement Let's Encrypt. Non
#                            définie = certificat émis sans contact, donc
#                            aucune alerte avant expiration.
NEXT_PUBLIC_API_URL_PROD=https://kop.life
CERTBOT_EMAIL=
