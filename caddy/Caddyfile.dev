# ─────────────────────────────────────────────────────────────────────
# Conf DEV — https://localhost:8443, certificat local auto-genere par la
# CA interne de Caddy (`tls internal`), mise en cache dans le volume
# caddy_dev_data. Meme avertissement navigateur qu'avant (a accepter une
# fois) : Caddy n'est pas une autorite publique, juste local.
# Redirection HTTP->HTTPS ecrite a la main (auto_https ne construit pas
# la bonne URL sur un port https non standard comme 8443) : meme genre
# de hack que nginx avec son "$host:8443" code en dur.
# La conf de prod est dans caddy/Caddyfile (kop.life, Let's Encrypt).
# ─────────────────────────────────────────────────────────────────────
{
	auto_https disable_redirects
}

:8080 {
	redir https://{host}:8443{uri} permanent
}

localhost:8443 {
	tls internal

	# ── Routes internes Next.js (posent/effacent les cookies httpOnly) ──
	handle /api/logout {
		reverse_proxy frontend:3000
	}
	handle /api/set-token {
		reverse_proxy frontend:3000
	}

	# ── API REST Django ───────────────────────────────────────────────
	handle /api/* {
		reverse_proxy backend:8000
	}

	# ── WebSockets (chat + notifications, channels/daphne) ────────────
	handle /ws/* {
		reverse_proxy backend:8000
	}

	# ── Admin & statiques Django (servis par WhiteNoise) ──────────────
	handle /admin/* {
		reverse_proxy backend:8000
	}
	handle /static/* {
		reverse_proxy backend:8000
	}

	# ── Medias uploades ────────────────────────────────────────────────
	# En dev c'est Django qui les sert (urls.py, bloc `if settings.DEBUG`),
	# contrairement a la prod ou Caddy lit directement le volume.
	handle /media/* {
		reverse_proxy backend:8000
	}

	# ── Frontend Next.js ───────────────────────────────────────────────
	# reverse_proxy relaie les WebSockets automatiquement (HMR de Next
	# compris), pas besoin d'entetes Upgrade/Connection explicites.
	handle {
		reverse_proxy frontend:3000
	}
}
