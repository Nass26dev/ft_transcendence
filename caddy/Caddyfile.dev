{
	auto_https disable_redirects
}

:8080 {
	redir https://{host}:8443{uri} permanent
}

localhost:8443 {
	tls internal

	handle /api/logout {
		reverse_proxy frontend:3000
	}
	handle /api/set-token {
		reverse_proxy frontend:3000
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /ws/* {
		reverse_proxy backend:8000
	}

	handle /admin/* {
		reverse_proxy backend:8000
	}
	handle /static/* {
		reverse_proxy backend:8000
	}

	handle /media/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
